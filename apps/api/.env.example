# Full API configuration. Copy to apps/api/.env, then replace secret placeholders.
# Real provider credentials belong only in the ignored local .env file.

# Runtime and database (A2 uses its own PostgreSQL volume).
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public
TEST_DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite_test?schema=public

# Authentication and OTP signing: use different secrets for JWT and OTP.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="1d"
OTP_HASH_SECRET="replace-with-a-separate-random-secret-at-least-32-characters"
AUTH_OTP_DEMO=true

# Sample profile uses local SMS. For eSMS, set SMS_PROVIDER=esms and fill keys.
SMS_PROVIDER=local
ESMS_API_KEY=""
ESMS_SECRET_KEY=""
ESMS_BRANDNAME="YOUR_APPROVED_BRANDNAME"
ESMS_OTP_TEMPLATE="{OTP} la ma xac minh cua ban"
ESMS_TIMEOUT_MS=10000

# Optional manager account created by prisma:seed in development/test.
AUTH_DEMO_SEED=false
DEMO_MANAGER_PHONE=""
DEMO_MANAGER_PASSWORD=""

# VNPAY sandbox. The sample profile uses mock payments.
VNPAY_TMN_CODE="SANDBOX_TMN_CODE"
VNPAY_HASH_SECRET="SANDBOX_HASH_SECRET"
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
VNPAY_RETURN_URL="http://localhost:3000/payment/vnpay-return"
VNPAY_DEFAULT_BANKCODE=""
PAYMENT_EXPIRE_MINUTES=15
PAYMENT_MOCK_ENABLED=true
PAYMENT_RECONCILE_INTERVAL_MS=60000
ORDER_PENDING_EXPIRE_MINUTES=15
TRUST_PROXY=false

# Loyalty.
LOYALTY_WELCOME_POINTS=50000
